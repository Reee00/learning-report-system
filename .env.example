APP_NAME="Learning Report System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Contoh koneksi MySQL lokal; sesuaikan dengan environment Anda.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lrs_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===== WEB PUSH (PWA Phase 2) =====
# Kunci VAPID untuk notifikasi push ke perangkat. Generate dengan:
#     php artisan webpush:vapid
#
# KEAMANAN:
#   - VAPID_PRIVATE_KEY adalah rahasia server. JANGAN commit nilainya,
#     jangan kirim ke browser, dan jangan taruh di manifest/service worker.
#   - Hanya VAPID_PUBLIC_KEY yang boleh sampai ke klien (applicationServerKey).
#   - Kunci harus SAMA di semua instance produksi; menggantinya membuat seluruh
#     subscription perangkat yang sudah ada tidak berlaku lagi.
#
# Bila PUBLIC_KEY/PRIVATE_KEY dibiarkan kosong, fitur push nonaktif total:
# tombol "Aktifkan Notifikasi" tidak dirender dan notifikasi database tetap
# berjalan normal (push hanya kanal tambahan, bukan sumber kebenaran).
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
